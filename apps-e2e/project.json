{
  "name": "api-gateway-e2e",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": [
    "api-gateway"
  ],
  "targets": {
    "e2e": {
      "command": "jest --passWithNoTests",
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}"
      ],
      "dependsOn": [
        "api-gateway:build",
        "api-gateway:serve"
      ],
      "options": {
        "cwd": "apps-e2e"
      }
    }
  }
}
