# Database
DATABASE_URL=postgresql://platform_admin:YOUR_PASSWORD@localhost:5432/investment_service?schema=public
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD

# RabbitMQ
RABBITMQ_DEFAULT_USER=platform_admin
RABBITMQ_DEFAULT_PASS=YOUR_RABBITMQ_PASSWORD

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=YOUR_KEYCLOAK_PASSWORD

# Flowable
FLOWABLE_BASE_URL=http://localhost:8080/flowable-rest/service
FLOWABLE_USERNAME=rest-admin
FLOWABLE_PASSWORD=YOUR_FLOWABLE_PASSWORD
FLOWABLE_DB_PASSWORD=YOUR_FLOWABLE_DB_PASSWORD
FLOWABLE_REST_ADMIN_USER=rest-admin
FLOWABLE_REST_ADMIN_PASSWORD=YOUR_FLOWABLE_REST_PASSWORD

# Workflow Service
WORKFLOW_SERVICE_PORT=3001
WORKFLOW_SERVICE_URL=http://localhost:3001/api

# Internal Service Authentication
INTERNAL_SERVICE_SECRET=GENERATE_A_RANDOM_SECRET

ESCALATION_EMAIL=GENERATE_OR_CONFIGURE_ESCALATION_EMAIL

RABBITMQ_URL=amqp://platform_admin:YOUR_RABBITMQ_PASSWORD@localhost:5672
RABBITMQ_DEFAULT_QUEUE=investment-platform-events
